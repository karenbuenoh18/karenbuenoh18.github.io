---
const dimensions = ['Ingeniería', 'Cloud', 'DevOps', 'IA', 'Arquitectura', 'Flutter', 'UX', 'Danza', 'Música', 'Arte', 'Aprendizaje'];
---
<section id="inicio" class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="eyebrow" data-reveal>Universo digital</span>
      <h1 data-reveal data-reveal-delay="1">
        Construyo sistemas donde conviven<br />
        la <span class="grad">ingeniería</span> y la <span class="grad">creatividad</span>.
      </h1>
      <p class="hero-lead" data-reveal data-reveal-delay="2">
        Cloud, inteligencia artificial y arquitectura de software — y también danza, música y arte.
        No son mundos separados: son dimensiones del mismo ecosistema. Este es el espacio donde pienso,
        construyo y aprendo.
      </p>
      <div class="dims" data-reveal data-reveal-delay="3">
        {dimensions.map((d) => <span class="pill">{d}</span>)}
      </div>
      <div class="hero-cta" data-reveal data-reveal-delay="4">
        <a class="btn btn-primary" href="#proyectos">Explorar proyectos</a>
        <a class="btn btn-ghost" href="#sobre">Cómo pienso</a>
      </div>
    </div>

    <div class="hero-avatar" data-reveal data-reveal-delay="2">
      <div class="orbit">
        <span class="ring ring-1"></span>
        <span class="ring ring-2"></span>
        <span class="dot"></span>
        <img src="/imagenes/foto.jpg" alt="Karen Bueno" width="220" height="220" />
      </div>
    </div>
  </div>

  <a href="#sobre" class="scroll-cue" aria-label="Desplázate">
    <span>Explora</span>
    <svg width="18" height="26" viewBox="0 0 18 26" fill="none" aria-hidden="true">
      <rect x="1" y="1" width="16" height="24" rx="8" stroke="currentColor" opacity="0.5" />
      <circle cx="9" cy="8" r="2.5" fill="currentColor"><animate attributeName="cy" values="8;16;8" dur="1.8s" repeatCount="indefinite" /></circle>
    </svg>
  </a>
</section>

<style>
  .hero { min-height: 100svh; display: flex; align-items: center; position: relative; padding-top: 68px; }
  .hero-inner {
    display: grid; grid-template-columns: 1.35fr 0.9fr; gap: 48px; align-items: center;
  }
  .hero-copy h1 {
    font-size: clamp(1.8rem, 3.6vw, 2.9rem);
    margin: 20px 0 0;
  }
  .grad {
    background: var(--grad);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-lead { color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.2rem); margin-top: 26px; max-width: 54ch; }
  .dims { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; max-width: 40rem; }
  .hero-cta { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
  .btn {
    font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.03em;
    padding: 13px 22px; border-radius: 12px; transition: all 0.3s var(--ease);
    border: 1px solid transparent;
  }
  .btn-primary { background: var(--grad); color: #0a0a12; font-weight: 500; }
  .btn-primary:hover { color: #0a0a12; transform: translateY(-2px); box-shadow: 0 10px 30px var(--glow); }
  .btn-ghost { border-color: var(--border-2); color: var(--text); }
  .btn-ghost:hover { border-color: var(--a1); color: #fff; box-shadow: 0 0 22px rgba(162,76,255,0.18); }

  /* Avatar integrated into the system */
  .hero-avatar { display: flex; justify-content: center; }
  .orbit { position: relative; width: 300px; height: 300px; display: grid; place-items: center; }
  .orbit img {
    width: 210px; height: 210px; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--border-2);
    box-shadow: 0 0 60px rgba(162, 76, 255, 0.25), inset 0 0 40px rgba(0,0,0,0.4);
    filter: saturate(1.05) contrast(1.03);
  }
  .ring {
    position: absolute; border-radius: 50%; border: 1px solid var(--border);
    inset: 0;
  }
  .ring-1 { border-color: rgba(162,76,255,0.35); animation: spin 18s linear infinite; border-top-color: transparent; border-left-color: transparent; }
  .ring-2 { inset: 28px; border-color: rgba(255,60,172,0.25); animation: spin 26s linear infinite reverse; border-bottom-color: transparent; }
  .dot {
    position: absolute; top: 6px; left: 50%; width: 8px; height: 8px; border-radius: 50%;
    background: var(--a1); box-shadow: 0 0 14px var(--glow);
    transform-origin: 0 144px; animation: spin 12s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .scroll-cue {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: var(--muted); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  }

  /* En escritorio: el texto ocupa la izquierda y el avatar se ancla
     centrado verticalmente en la PANTALLA, a la derecha, sin depender
     del alto del bloque de texto. */
  @media (min-width: 861px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: calc(100svh - 136px);
      align-content: center;
    }
    .hero-copy { max-width: 58%; }
    .hero-avatar {
      position: absolute;
      right: clamp(24px, 6vw, 90px);
      top: 68px;
      bottom: 0;
      height: 300px;
      margin: auto 0;
      justify-content: flex-end;
    }
  }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: 36px; text-align: left; }
    .hero-avatar { order: -1; justify-content: flex-start; }
    .orbit { width: 200px; height: 200px; }
    .orbit img { width: 150px; height: 150px; }
    .dot { transform-origin: 0 97px; }
  }
</style>
