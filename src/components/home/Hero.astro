---
import { experience } from '../../data/experience';
import { site } from '../../data/site';
import { getLocale, path, useTranslations } from '../../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/** Split on the middot so the roles stagger in one at a time. */
const roles = t('hero.roles').split(' · ');

const current = experience[0];
---

<section id="hero" class="hero">
  <div class="container-wide inner">
    <div class="copy">
      <a class="chip" href="#experience">
        <span class="chip-dot" aria-hidden="true"></span>
        <span class="chip-text">
          <span class="chip-role">{current.title[locale]}</span>
          <span class="chip-at">{current.company}</span>
        </span>
      </a>

      {/* Single element, no transformed children: that is what lets
          background-clip: text paint the gradient across the whole name. */}
      <h1 class="name display grad-text">{site.wordmark}</h1>

      <p class="roles">
        {
          roles.map((r, i) => (
            <span class="role" style={`--i:${i}`}>
              {r}
            </span>
          ))
        }
      </p>

      <p class="pitch">{t('hero.lead')}</p>

      <div class="cta">
        <a class="btn btn-primary" href="#work">{t('hero.cta.primary')}</a>
        <a class="btn btn-ghost" href={path('/beyond', locale)}>
          <span class="orb" aria-hidden="true"></span>
          {t('hero.cta.secondary')}
        </a>
      </div>
    </div>

    <div class="avatar">
      <div class="orbit">
        <span class="ring ring-1" aria-hidden="true"></span>
        <span class="ring ring-2" aria-hidden="true"></span>
        <span class="sat" aria-hidden="true"></span>
        <img src={site.avatar} alt={site.name} width="440" height="440" loading="eager" />
      </div>
    </div>
  </div>

  <a href="#about" class="scroll-cue" aria-label={t('hero.scroll')}>
    <span class="mono">{t('hero.scroll')}</span>
    <span class="line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + var(--s-6));
    padding-bottom: var(--s-10);
  }

  .hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 38%;
    width: min(1100px, 120%);
    aspect-ratio: 2 / 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(162, 76, 255, 0.13), transparent 72%);
    filter: blur(30px);
    pointer-events: none;
  }

  .inner {
    display: grid;
    gap: clamp(24px, 4vh, 44px);
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: clamp(20px, 3.5vh, 40px);
  }

  /* ---- Credential chip ---- */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-full);
    background: var(--glass-1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    animation: rise 0.9s var(--ease) both;
    transition:
      border-color var(--t-med) var(--ease),
      background var(--t-med) var(--ease);
  }

  .chip:hover {
    border-color: var(--line-2);
    background: var(--glass-2);
  }

  .chip-text {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-size: var(--fs-sm);
    line-height: 1;
  }

  .chip-role {
    color: var(--text);
    font-weight: 500;
  }

  .chip-at {
    color: var(--text-3);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--a);
    box-shadow: 0 0 10px var(--glow-tight);
    animation: pulse 2.6s var(--ease-in-out) infinite;
    flex: none;
  }

  /* ---- Name ---- */
  .name {
    margin: 0;
    /* The gradient needs a little vertical room or the descender box
       clips the fill on some engines. */
    padding-bottom: 0.06em;
    animation: nameIn 1.1s var(--ease) both;
    animation-delay: 0.12s;
  }

  @keyframes nameIn {
    from {
      opacity: 0;
      transform: translateY(0.22em);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  /* ---- Roles ---- */
  .roles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 0;
    max-width: 44rem;
  }

  .role {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--text);
    animation: rise 0.8s var(--ease) both;
    animation-delay: calc(0.46s + var(--i) * 0.07s);
  }

  .role + .role::before {
    content: '·';
    color: var(--a);
    margin: 0 12px;
  }

  /* ---- Pitch ---- */
  .pitch {
    font-size: clamp(1.0625rem, 1.3vw + 0.8rem, 1.5rem);
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--text-2);
    max-width: 32ch;
    text-wrap: balance;
    animation: rise 0.9s var(--ease) both;
    animation-delay: 0.68s;
  }

  /* ---- CTAs ---- */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--s-2);
    animation: rise 0.9s var(--ease) both;
    animation-delay: 0.8s;
  }

  .orb {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 10px var(--glow);
    flex: none;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- Portrait ----
     Anchored to .hero (not .inner) so it centres on the viewport rather
     than on the height of the text block. */
  .avatar {
    display: flex;
    justify-content: center;
    animation: rise 1s var(--ease) both;
    animation-delay: 0.3s;
  }

  .orbit {
    position: relative;
    width: 320px;
    height: 320px;
    display: grid;
    place-items: center;
  }

  .orbit img {
    width: 232px;
    height: 232px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-2);
    box-shadow:
      0 0 70px rgba(162, 76, 255, 0.28),
      inset 0 0 40px rgba(0, 0, 0, 0.4);
    filter: saturate(1.05) contrast(1.03);
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  .ring-1 {
    border-color: rgba(162, 76, 255, 0.38);
    border-top-color: transparent;
    border-left-color: transparent;
    animation: spin 18s linear infinite;
  }

  .ring-2 {
    inset: 30px;
    border-color: rgba(255, 60, 172, 0.26);
    border-bottom-color: transparent;
    animation: spin 26s linear infinite reverse;
  }

  .sat {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--a);
    box-shadow: 0 0 14px var(--glow-tight);
    transform-origin: 0 0;
    animation: satellite 12s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes satellite {
    from {
      transform: rotate(0deg) translateX(160px);
    }
    to {
      transform: rotate(360deg) translateX(160px);
    }
  }

  /* ---- Scroll cue ---- */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--text-4);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    animation: rise 1s var(--ease) both;
    animation-delay: 1.05s;
  }

  .scroll-cue:hover {
    color: var(--text-2);
  }

  .scroll-cue .line {
    width: 1px;
    height: 40px;
    background: linear-gradient(var(--line-3), transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-cue .line::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 12px;
    background: var(--a);
    box-shadow: 0 0 8px var(--glow-tight);
    animation: trickle 2.2s var(--ease-in-out) infinite;
  }

  @keyframes trickle {
    0% {
      transform: translateY(-14px);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    100% {
      transform: translateY(40px);
      opacity: 0;
    }
  }

  /* ---- Desktop: copy left, portrait pinned right and centred on screen ---- */
  @media (min-width: 981px) {
    .copy {
      max-width: 56%;
    }

    .avatar {
      position: absolute;
      top: 50%;
      /* Hugs the container edge on wide screens instead of drifting to
         the window edge. */
      right: max(var(--gutter), calc((100% - var(--w-wide)) / 2 + var(--gutter)));
      transform: translateY(-50%);
      justify-content: flex-end;
    }
  }

  @media (min-width: 981px) and (max-width: 1180px) {
    .orbit {
      width: 270px;
      height: 270px;
    }
    .orbit img {
      width: 196px;
      height: 196px;
    }
    .ring-2 {
      inset: 26px;
    }
    .sat {
      animation-name: satelliteSm;
    }
  }

  /* ---- Tablet and below: portrait above the copy ---- */
  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-h) + var(--s-7));
      padding-bottom: var(--s-9);
    }

    .avatar {
      order: -1;
      justify-content: flex-start;
    }

    .copy {
      order: 1;
    }

    .pitch {
      max-width: 100%;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .orbit {
      width: 250px;
      height: 250px;
    }
    .orbit img {
      width: 182px;
      height: 182px;
    }
    .ring-2 {
      inset: 24px;
    }
    .sat {
      animation-name: satelliteSm;
    }
    .cta .btn {
      flex: 1 1 auto;
    }
  }

  @keyframes satelliteSm {
    from {
      transform: rotate(0deg) translateX(125px);
    }
    to {
      transform: rotate(360deg) translateX(125px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .role,
    .pitch,
    .cta,
    .chip,
    .avatar,
    .scroll-cue,
    .ring {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }

    /* Without its orbit the satellite would sit dead centre on the
       portrait, so it goes away entirely; the rings close instead. */
    .sat {
      display: none;
    }

    .ring-1,
    .ring-2 {
      border-color: rgba(162, 76, 255, 0.28);
    }
  }
</style>
