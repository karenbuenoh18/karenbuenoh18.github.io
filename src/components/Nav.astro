---
const links = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#sobre', label: 'Sobre mí' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '/creatividad', label: 'Danza & Arte', blank: true },
  { href: '#contacto', label: 'Contacto' },
];
---
<div id="progress" aria-hidden="true"></div>
<header id="nav">
  <div class="nav-inner container">
    <a href="#inicio" class="logo">KAREN<span>.</span></a>

    <nav class="links" id="nav-links">
      {links.map((l) => (
        <a href={l.href} target={l.blank ? '_blank' : undefined} rel={l.blank ? 'noopener' : undefined}>
          {l.label}{l.blank && <span class="ext" aria-hidden="true">↗</span>}
        </a>
      ))}
    </nav>

    <button id="nav-toggle" class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<style>
  #progress {
    position: fixed; top: 0; left: 0; height: 2px; width: 0%;
    background: var(--grad);
    box-shadow: 0 0 12px var(--glow);
    z-index: 1001;
    transition: width 0.1s linear;
  }
  #nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    border-bottom: 1px solid transparent;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease), backdrop-filter 0.4s var(--ease);
  }
  #nav.scrolled {
    background: rgba(6, 6, 9, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 68px;
  }
  .logo {
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
    letter-spacing: 0.16em; color: #fff;
  }
  .logo span { color: var(--a1); }
  .links { display: flex; gap: 30px; }
  .links a {
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em;
    color: var(--muted); position: relative; padding: 6px 0;
  }
  .links a::after {
    content: ''; position: absolute; left: 0; bottom: 0; height: 1px; width: 0;
    background: var(--grad); transition: width 0.3s var(--ease);
  }
  .links a:hover { color: #fff; }
  .links a:hover::after { width: 100%; }
  .links a .ext { font-size: 0.72em; margin-left: 3px; opacity: 0.7; }

  /* Hamburger button — hidden on desktop */
  .nav-toggle {
    display: none;
    width: 44px; height: 44px;
    background: none; border: 0; cursor: pointer;
    padding: 10px; margin-right: -10px;
    flex-direction: column; justify-content: center; gap: 5px;
  }
  .nav-toggle .bar {
    display: block; height: 2px; width: 22px; border-radius: 2px;
    background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 720px) {
    .nav-toggle { display: flex; }

    /* Slide-down glass panel */
    .links {
      position: fixed;
      top: 68px; left: 0; right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px 0 14px;
      background: rgba(8, 8, 14, 0.92);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
      transform: translateY(-12px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.3s var(--ease), opacity 0.3s var(--ease), visibility 0.3s;
    }
    .links.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }
    .links a {
      font-size: 0.95rem;
      padding: 15px 24px;
      width: 100%;
    }
    .links a::after { display: none; }
    .links a:active { background: var(--surface-2); }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const bar = document.getElementById('progress');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-links');

  const onScroll = () => {
    const y = window.scrollY;
    nav?.classList.toggle('scrolled', y > 24);
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    if (bar) bar.style.width = `${Math.min(100, (y / (docH || 1)) * 100)}%`;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const closeMenu = () => {
    menu?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú');
  };
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  });
  // Close after tapping a link or pressing Escape
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
</script>
