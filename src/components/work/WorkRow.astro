---
import { localize, type WorkProject } from '../../data/work';
import { getLocale, path } from '../../i18n/utils';

interface Props {
  project: WorkProject;
  index: number;
}

const { project, index } = Astro.props as Props;
const locale = getLocale(Astro.url);
const p = localize(project, locale);
const href = path(`/work/${project.slug}`, locale);
const num = String(index).padStart(2, '0');
---

{/* Compact archive row. The index page uses these rather than the large
    home cards, so the archive stays scannable at thirty projects. */}
<a class="row" href={href} data-category={project.category}>
  <span class="num mono">{num}</span>

  <span class="main">
    <span class="title">{p.title}</span>
    <span class="tagline">{p.tagline}</span>
    <span class="tech">
      {project.tech.slice(0, 5).map((t) => <span class="t mono">{t}</span>)}
    </span>
  </span>

  <span class="meta">
    <span class="domain mono">{p.domain}</span>
    <span class="period mono">{project.period}</span>
  </span>

  <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto 24px;
    align-items: start;
    gap: var(--s-5);
    padding: var(--s-5) var(--s-4);
    border-bottom: 1px solid var(--line);
    border-radius: var(--r-md);
    transition: background var(--t-fast) var(--ease);
  }

  .row:hover {
    background: var(--glass-1);
  }

  .num {
    color: var(--text-4);
    letter-spacing: 0.1em;
    padding-top: 4px;
  }

  .main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .title {
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.022em;
    color: var(--text);
    line-height: 1.25;
  }

  .tagline {
    font-size: var(--fs-base);
    color: var(--text-3);
    line-height: 1.55;
    max-width: 68ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-top: 2px;
  }

  .t {
    color: var(--text-4);
  }

  .meta {
    display: grid;
    gap: 6px;
    justify-items: end;
    text-align: right;
    flex: none;
    padding-top: 3px;
  }

  .domain {
    color: var(--a-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .period {
    color: var(--text-4);
  }

  .arrow {
    color: var(--text-4);
    padding-top: 3px;
    transition:
      transform var(--t-med) var(--ease),
      color var(--t-med) var(--ease);
  }

  .row:hover .arrow {
    color: var(--a-soft);
    transform: translateX(4px);
  }

  @media (max-width: 800px) {
    .row {
      grid-template-columns: 32px minmax(0, 1fr) 20px;
      gap: var(--s-4);
    }
    .meta {
      grid-column: 2;
      grid-row: 2;
      justify-items: start;
      text-align: left;
      flex-direction: row;
      display: flex;
      gap: var(--s-4);
      padding-top: 0;
    }
  }
</style>
