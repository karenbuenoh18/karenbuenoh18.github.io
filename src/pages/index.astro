---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';

const upcoming = [
  { n: '02', t: 'Arquitecturas', d: 'Diagramas vivos de los sistemas que he construido, y cómo se conectan las piezas.' },
  { n: '03', t: 'Timeline', d: 'La evolución: cómo pasé de una disciplina a otra y qué aprendí en cada etapa.' },
  { n: '04', t: 'Laboratorio', d: 'Experimentos, prompts, agentes, MCPs y herramientas. Un laboratorio vivo.' },
  { n: '05', t: 'Bitácora', d: 'Un segundo cerebro público: notas, conceptos, mapas mentales y reflexiones.' },
];
---
<Base>
  <Nav />
  <main>
    <Hero />
    <About />
    <Projects />

    <!-- Adelanto del recorrido que viene (Fases 2 y 3) -->
    <section id="proximo" class="section">
      <div class="container">
        <span class="eyebrow" data-reveal>El recorrido continúa</span>
        <h2 class="section-title" data-reveal data-reveal-delay="1">Próximas estancias del universo.</h2>
        <div class="up-grid">
          {upcoming.map((u, i) => (
            <div class="up card" data-reveal data-reveal-delay={((i % 4) + 1).toString()}>
              <span class="up-n">{u.n}</span>
              <h3>{u.t}</h3>
              <p>{u.d}</p>
              <span class="up-soon">Próximamente</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section contact">
      <div class="container">
        <span class="eyebrow" data-reveal>Contacto</span>
        <h2 class="section-title" data-reveal data-reveal-delay="1">¿Construimos algo que conecte mundos?</h2>
        <p class="section-lead" data-reveal data-reveal-delay="2">
          Me encantan las conversaciones con personas curiosas: ingeniería, IA, un proyecto, una idea o una pista de baile.
        </p>
        <div class="contact-links" data-reveal data-reveal-delay="3">
          <a class="c-link" href="mailto:karenbuenoh1809@gmail.com">Escríbeme</a>
          <a class="c-link" href="https://www.linkedin.com/in/karenbuenoh18/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="c-link" href="https://github.com/karenbuenoh18" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>Karen Bueno</span>
      <span class="f-quote">Si lo puedo imaginar, lo puedo programar.</span>
      <span>© 2026</span>
    </div>
  </footer>
</Base>

<style>
  .up-grid { margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: 20px; }
  .up { padding: 24px; }
  .up-n { font-family: var(--font-mono); font-size: 0.78rem; color: var(--a1); letter-spacing: 0.1em; }
  .up h3 { font-size: 1.2rem; margin: 12px 0 8px; }
  .up p { color: var(--muted); font-size: 0.92rem; }
  .up-soon {
    display: inline-block; margin-top: 16px; font-family: var(--font-mono); font-size: 0.66rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint);
    border: 1px solid var(--border); border-radius: 999px; padding: 3px 10px;
  }

  .contact { text-align: left; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .c-link {
    font-family: var(--font-mono); font-size: 0.85rem; color: var(--text);
    border: 1px solid var(--border-2); border-radius: 12px; padding: 13px 24px;
    transition: all 0.3s var(--ease);
  }
  .c-link:hover { border-color: var(--a1); color: #fff; transform: translateY(-2px); box-shadow: 0 8px 26px rgba(162,76,255,0.18); }

  .footer { border-top: 1px solid var(--border); padding: 34px 0; margin-top: 40px; }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted);
  }
  .f-quote { color: var(--faint); }
  @media (max-width: 560px) { .footer-inner { flex-direction: column; gap: 8px; text-align: center; } }
</style>
